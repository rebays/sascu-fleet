PORT=5000
NODE_ENV=development

# MongoDB Atlas (or local) connection string
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/vehiclebooking

# Used to build the password-reset link emailed to users
FRONTEND_URL=http://localhost:3000

# Long random string used to sign/verify JWTs (auth + password reset tokens)
JWT_SECRET=your_very_long_random_string_here_128_chars_minimum

# Branding shown in transactional emails and generated invoices/receipts
COMPANY_NAME=SASCU Rentals
COMPANY_ADDRESS=123 Address, Honiara, Solomon Islands
COMPANY_EMAIL=info@example.com
COMPANY_PHONE=+677 000 0000

# --- Email (all transactional email — booking notices, invoices, receipts,
# password resets — goes through Resend's HTTPS API via utils/mailer.js) ---
# Get/rotate the key at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Sender address. Until a custom domain (or subdomain) is verified in Resend,
# this MUST stay onboarding@resend.dev, and Resend will only deliver to the
# email address that owns the Resend account (not arbitrary customers).
# Once verified — recommended: a subdomain like mail.yourdomain.com, so
# Resend's SPF/DKIM records don't touch the root domain's existing mail
# setup (e.g. Zoho/Google Workspace office mail) — switch this to an
# address on that domain, e.g. booking@mail.yourdomain.com.
RESEND_FROM_EMAIL=onboarding@resend.dev
# Optional CC on every invoice/receipt (leave blank for none)
INVOICE_CC=

# Inbox that receives "new booking" notifications (used by bookingEmails.js).
# Defaults to COMPANY_EMAIL if left blank.
ADMIN_NOTIFICATION_EMAIL=

# Vercel Blob (used to store/delete vehicle photos)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxx
